URL_RE = re.compile(
    r"https?://(?:pan\.baidu\.com|yun\.baidu\.com|pan\.quark\.cn|drive\.uc\.cn|pan\.uc\.cn|pan\.xunlei\.com)/[^\s<>\"']+",
    re.I,
)
PASSCODE_RE = re.compile(r"(?:提取码|访问码|密码|pwd)\s*[:：=]?\s*([A-Za-z0-9]{3,8})", re.I)
SYNC_LOCK = threading.Lock()
