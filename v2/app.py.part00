def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime | None) -> str | None:
    return dt.isoformat() if dt else None


def require_env() -> None:
    missing = []
    if not DATABASE_URL:
        missing.append("DATABASE_URL")
    if not ADMIN_PASSWORD:
        missing.append("ADMIN_PASSWORD")
    if not COOKIE_ENCRYPTION_KEY:
        missing.append("COOKIE_ENCRYPTION_KEY")
    if not CRON_SECRET:
        missing.append("CRON_SECRET")
    if missing:
        raise RuntimeError("缺少环境变量：" + ", ".join(missing))


def connect_db():
    return psycopg.connect(DATABASE_URL, row_factory=dict_row, autocommit=False)


def init_db() -> None:
    statements = [
        """
        CREATE TABLE IF NOT EXISTS resources(
            id BIGSERIAL PRIMARY KEY,
            title TEXT NOT NULL,
            platform TEXT NOT NULL,
            source_url TEXT NOT NULL,
            source_code TEXT NOT NULL DEFAULT '',
            target_url TEXT NOT NULL DEFAULT '',
            target_code TEXT NOT NULL DEFAULT '',
            target_fid TEXT NOT NULL DEFAULT '',
            save_dir TEXT NOT NULL DEFAULT '',
            status TEXT NOT NULL DEFAULT 'pending',
            last_message TEXT NOT NULL DEFAULT '',
            interval_minutes INTEGER NOT NULL DEFAULT 60,
            enabled BOOLEAN NOT NULL DEFAULT TRUE,
            last_run TIMESTAMPTZ,
            next_run TIMESTAMPTZ,
            created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
            updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
            UNIQUE(platform, source_url)
        )
        """,
        """
        CREATE TABLE IF NOT EXISTS credentials(
            platform TEXT PRIMARY KEY,
            secret_cipher TEXT NOT NULL,
            source TEXT NOT NULL DEFAULT 'manual',
            updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
        )
        """,
        """
        CREATE TABLE IF NOT EXISTS pair_tokens(
            code_hash TEXT PRIMARY KEY,
            platform TEXT NOT NULL,
            expires_at TIMESTAMPTZ NOT NULL,
            used_at TIMESTAMPTZ,
            created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
        )
        """,
        """
        CREATE TABLE IF NOT EXISTS sync_logs(
            id BIGSERIAL PRIMARY KEY,
            resource_id BIGINT REFERENCES resources(id) ON DELETE SET NULL,
            level TEXT NOT NULL,
            action TEXT NOT NULL,
            message TEXT NOT NULL,
            details TEXT NOT NULL DEFAULT '',
            created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
        )
        """,
        "CREATE INDEX IF NOT EXISTS idx_resources_due ON resources(enabled, next_run)",
        "CREATE INDEX IF NOT EXISTS idx_logs_created ON sync_logs(created_at DESC)",
    ]
    with connect_db() as conn:
        for statement in statements:
            conn.execute(statement)
        conn.commit()


def fernet() -> Fernet:
    key = base64.urlsafe_b64encode(hashlib.sha256(COOKIE_ENCRYPTION_KEY.encode("utf-8")).digest())
    return Fernet(key)


def encrypt_secret(data: dict[str, Any]) -> str:
    payload = json.dumps(data, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    return fernet().encrypt(payload).decode("ascii")


def decrypt_secret(value: str) -> dict[str, Any]:
    try:
        return json.loads(fernet().decrypt(value.encode("ascii")).decode("utf-8"))
    except Exception as exc:
        raise RuntimeError("登录凭证无法解密，请重新登录绑定") from exc


def platform_from_url(url: str) -> str | None:
    host = urllib.parse.urlsplit(url).netloc.lower()
    if "baidu.com" in host:
        return "baidu"
    if "quark.cn" in host:
        return "quark"
    if "uc.cn" in host:
        return "uc"
    if "xunlei.com" in host:
        return "xunlei"
    return None


def clean_url(raw: str) -> str:
    return raw.strip().rstrip("，,。；;）)]}>\"'")


def extract_code(url: str, context: str = "") -> str:
    query = urllib.parse.parse_qs(urllib.parse.urlsplit(url).query)
    for key in ("pwd", "passcode", "code"):
        if query.get(key):
            return str(query[key][0])[:16]
    match = PASSCODE_RE.search(context)
    return match.group(1) if match else ""


def normalize_title(value: str, fallback: str = "未命名资源") -> str:
    value = re.sub(URL_RE, "", value or "")
    value = PASSCODE_RE.sub("", value)
    value = re.sub(r"^[\s|｜:：,，;；\-—_]+|[\s|｜:：,，;；\-—_]+$", "", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value[:180] or fallback


def parse_text_records(text: str) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    previous_title = ""
    for raw_line in text.replace("\r", "\n").split("\n"):
        line = raw_line.strip()
        if not line:
            continue
        urls = [clean_url(x) for x in URL_RE.findall(line)]
        if not urls:
            if len(line) <= 220:
                previous_title = normalize_title(line, previous_title or "未命名资源")
            continue
        before = line.split(urls[0], 1)[0] if urls[0] in line else line
        row_title = normalize_title(before, previous_title or "未命名资源")
