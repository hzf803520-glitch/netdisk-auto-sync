        for url in urls:
            platform = platform_from_url(url)
            if not platform:
                continue
            records.append(
                {
                    "title": row_title,
                    "platform": platform,
                    "source_url": url,
                    "source_code": extract_code(url, line),
                }
            )
        previous_title = row_title
    return dedupe_records(records)


def dedupe_records(records: list[dict[str, str]]) -> list[dict[str, str]]:
    merged: dict[tuple[str, str], dict[str, str]] = {}
    for item in records:
        key = (item["platform"], item["source_url"])
        if key not in merged or merged[key]["title"] == "未命名资源":
            merged[key] = item
    return list(merged.values())


def parse_xlsx(data: bytes) -> list[dict[str, str]]:
    wb = load_workbook(io.BytesIO(data), read_only=True, data_only=True)
    output: list[dict[str, str]] = []
    for ws in wb.worksheets:
        previous_title = ""
        for row in ws.iter_rows(values_only=True):
            cells = ["" if value is None else str(value).strip() for value in row]
            joined = " | ".join(x for x in cells if x)
            urls = [clean_url(x) for x in URL_RE.findall(joined)]
            title_cells = [x for x in cells if x and not URL_RE.search(x) and not PASSCODE_RE.fullmatch(x)]
            title = normalize_title(title_cells[0] if title_cells else previous_title, previous_title or ws.title)
            if urls:
                for url in urls:
                    platform = platform_from_url(url)
                    if platform:
                        output.append(
                            {
                                "title": title,
                                "platform": platform,
                                "source_url": url,
                                "source_code": extract_code(url, joined),
                            }
                        )
                previous_title = title
            elif title_cells:
                previous_title = title
    return dedupe_records(output)


def parse_csv_bytes(data: bytes) -> list[dict[str, str]]:
    text = ""
    for encoding in ("utf-8-sig", "gb18030", "utf-8"):
        try:
            text = data.decode(encoding)
            break
        except UnicodeDecodeError:
            continue
    reader = csv.reader(io.StringIO(text))
    return parse_text_records("\n".join(" | ".join(row) for row in reader))


def parse_docx(data: bytes) -> list[dict[str, str]]:
    with zipfile.ZipFile(io.BytesIO(data)) as zf:
        xml = zf.read("word/document.xml")
    root = ElementTree.fromstring(xml)
    texts: list[str] = []
    for node in root.iter():
        if node.tag.endswith("}t") and node.text:
            texts.append(node.text)
        elif node.tag.endswith("}p"):
            texts.append("\n")
    return parse_text_records("".join(texts))


def parse_uploaded_file(filename: str, data: bytes) -> list[dict[str, str]]:
    suffix = Path(filename).suffix.lower()
    if suffix == ".xlsx":
        return parse_xlsx(data)
    if suffix == ".csv":
        return parse_csv_bytes(data)
    if suffix == ".docx":
        return parse_docx(data)
    if suffix in {".txt", ".md", ".log"}:
        for encoding in ("utf-8-sig", "gb18030", "utf-8"):
            try:
                return parse_text_records(data.decode(encoding))
            except UnicodeDecodeError:
                continue
    raise ValueError("仅支持 TXT、CSV、XLSX、DOCX 文档")


def import_records(records: list[dict[str, str]], interval_minutes: int = DEFAULT_INTERVAL) -> dict[str, int]:
    interval_minutes = max(15, min(int(interval_minutes), 10080))
    inserted = 0
    updated = 0
    with connect_db() as conn:
        for item in records:
            existing = conn.execute(
                "SELECT id FROM resources WHERE platform=%s AND source_url=%s",
                (item["platform"], item["source_url"]),
            ).fetchone()
            conn.execute(
                """
                INSERT INTO resources(title,platform,source_url,source_code,interval_minutes,next_run)
                VALUES(%s,%s,%s,%s,%s,NOW())
                ON CONFLICT(platform,source_url) DO UPDATE SET
                    title=EXCLUDED.title,
                    source_code=CASE WHEN EXCLUDED.source_code<>'' THEN EXCLUDED.source_code ELSE resources.source_code END,
                    interval_minutes=EXCLUDED.interval_minutes,
                    enabled=TRUE,
                    updated_at=NOW()
                """,
                (
                    item["title"],
                    item["platform"],
                    item["source_url"],
                    item.get("source_code", ""),
                    interval_minutes,
                ),
            )
            if existing:
                updated += 1
            else:
                inserted += 1
        conn.commit()
    return {"inserted": inserted, "updated": updated, "total": inserted + updated}


def log_event(level: str, action: str, message: str, resource_id: int | None = None, details: str = "") -> None:
    try:
        with connect_db() as conn:
            conn.execute(
                "INSERT INTO sync_logs(resource_id,level,action,message,details) VALUES(%s,%s,%s,%s,%s)",
                (resource_id, level, action, message[:1000], details[:8000]),
            )
            conn.commit()
    except Exception:
        print("写入日志失败", traceback.format_exc())


def get_credentials(platform: str) -> dict[str, Any] | None:
    with connect_db() as conn:
        row = conn.execute("SELECT secret_cipher FROM credentials WHERE platform=%s", (platform,)).fetchone()
    return decrypt_secret(row["secret_cipher"]) if row else None


def save_credentials(platform: str, data: dict[str, Any], source: str) -> None:
    if platform not in SUPPORTED_PLATFORMS:
        raise ValueError("不支持的平台")
    cleaned = {str(k): str(v).strip() for k, v in data.items() if str(v).strip()}
    if platform in {"baidu", "quark", "uc"} and not cleaned.get("cookie"):
        raise ValueError("没有检测到登录 Cookie，请确认已在登录助手中完成登录")
    if platform == "xunlei" and not (cleaned.get("refresh_token") or cleaned.get("access_token")):
        raise ValueError("没有检测到迅雷 access_token 或 refresh_token，请重新登录或手动填写令牌")
    cipher = encrypt_secret(cleaned)
    with connect_db() as conn:
        conn.execute(
            """
            INSERT INTO credentials(platform,secret_cipher,source,updated_at)
            VALUES(%s,%s,%s,NOW())
            ON CONFLICT(platform) DO UPDATE SET secret_cipher=EXCLUDED.secret_cipher,source=EXCLUDED.source,updated_at=NOW()
            """,
            (platform, cipher, source),
        )
        conn.commit()
    log_event("info", "credential", f"{SUPPORTED_PLATFORMS[platform]['name']} 登录状态已更新")


def worker_call(payload: dict[str, Any], timeout: int = 210) -> dict[str, Any]:
    if not WORKER_PATH.exists():
        raise RuntimeError("转存执行器不存在，请检查 Render 构建日志")
    proc = subprocess.run(
        [str(WORKER_PATH)],
        input=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        cwd=str(ROOT),
    )
    stdout = proc.stdout.decode("utf-8", "ignore").strip()
    stderr = proc.stderr.decode("utf-8", "ignore").strip()
    result = None
    for line in reversed(stdout.splitlines()):
        try:
            result = json.loads(line)
            break
        except Exception:
            continue
    if result is None:
        raise RuntimeError((stderr or stdout or "执行器没有返回结果")[-2000:])
    if not result.get("success"):
        raise RuntimeError(str(result.get("error") or stderr or "转存失败"))
    return result


def sync_one(resource: dict[str, Any]) -> bool:
    resource_id = int(resource["id"])
    platform = resource["platform"]
    platform_name = SUPPORTED_PLATFORMS.get(platform, {}).get("name", platform)
    credentials = get_credentials(platform)
    if not credentials:
        message = f"尚未绑定{platform_name}账号"
        with connect_db() as conn:
            conn.execute(
                "UPDATE resources SET status='waiting_credentials',last_message=%s,last_run=NOW(),next_run=NOW()+(interval_minutes||' minutes')::interval,updated_at=NOW() WHERE id=%s",
                (message, resource_id),
            )
            conn.commit()
        log_event("warning", "sync", message, resource_id)
        return False

    with connect_db() as conn:
        conn.execute(
            "UPDATE resources SET status='running',last_message='正在转存',last_run=NOW(),updated_at=NOW() WHERE id=%s",
            (resource_id,),
